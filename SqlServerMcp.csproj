<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SqlServerMcp</AssemblyName>
    <RootNamespace>SqlServerMcp</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- http 模式（Streamable HTTP 传输）依赖 ASP.NET Core 共享框架；stdio 模式不影响，仅多引用框架 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.json 含真实凭据且已被 .gitignore 排除：CI / 发布环境中该文件可能根本不存在，
         故用条件包含，避免无条件 Include 导致构建失败 -->
    <Content Include="appsettings.json" Condition="Exists('appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- 示例模板恒随构建输出，供 CI（生成 appsettings.json）与发布产物（不含真实凭据）使用 -->
    <Content Include="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 测试项目位于 tests/ 子目录，排除出主程序集编译 -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <!-- 测试项目需要访问 internal 成员（DatabaseService.ExecuteQueryAsync 等） -->
  <ItemGroup>
    <InternalsVisibleTo Include="SqlServerMcp.Tests" />
  </ItemGroup>

</Project>
