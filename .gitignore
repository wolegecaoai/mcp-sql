bin/
obj/

# 临时构建输出目录（bin-test / bin-verify-unit 等，见 AGENTS.md 的构建锁绕行方式）
bin-*/
*.user
*.suo
.vs/
publish/

# RID 发布/打包临时输出（release 工作流与本地冒烟使用；内含 appsettings.json 副本，禁止提交）
out/

# 含数据库连接字符串与密码，禁止提交到版本库
appsettings.json

# appsettings 的各种副本/备份（如「appsettings - 副本.json」）同样含真实凭据，一律忽略；
# 例外保留可提交的示例模板（否决规则须排在通配规则之后）
appsettings*.json
!appsettings.example.json

# 审计日志（可能含 SQL 预览与库名）
logs/

# IDE 本地项目数据，不纳入版本库
.codebuddy/
