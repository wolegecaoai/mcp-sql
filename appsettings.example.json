{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SqlServer": {
    "CommandTimeoutSeconds": 30,
    "AllowWrite": true,
    "AuditRetentionDays": 30,
    "StartupConnectivityCheck": false,
    "DangerousKeywords": [
      "DROP DATABASE",
      "CREATE DATABASE",
      "ALTER DATABASE",
      "RESTORE DATABASE",
      "BACKUP DATABASE",
      "ATTACH_DB",
      "xp_cmdshell",
      "sp_configure",
      "SHUTDOWN",
      "KILL",
      "CREATE LOGIN",
      "ALTER LOGIN",
      "DROP LOGIN",
      "CREATE SERVER ROLE",
      "ALTER SERVER ROLE",
      "DROP SERVER ROLE",
      "ALTER AUTHORIZATION",
      "GRANT",
      "REVOKE",
      "DENY",
      "OPENROWSET",
      "OPENDATASOURCE",
      "OPENQUERY",
      "xp_dirtree",
      "sp_OACreate",
      "dblink",
      "pg_read_file",
      "pg_read_binary_file",
      "pg_ls_dir",
      "lo_import",
      "lo_export",
      "LOAD_FILE",
      "INTO OUTFILE",
      "INTO DUMPFILE"
    ],
    "Databases": {
      "MySqlServerDb": {
        "Type": "sqlserver",
        "ConnectionString": "Server=localhost;Database=MyDb;User Id=sa;Password=your_password;TrustServerCertificate=True;",
        "Description": "SQL Server 示例（SQL Server 身份验证）"
      },
      "MyWindowsAuthDb": {
        "Type": "sqlserver",
        "ConnectionString": "Server=localhost;Database=MyDb;Integrated Security=true;TrustServerCertificate=True;",
        "Description": "SQL Server 示例（Windows 集成验证）"
      },
      "MyMySqlDb": {
        "Type": "mysql",
        "ConnectionString": "Server=127.0.0.1;Port=3306;Database=your_mysql_db;User=root;Password=your_mysql_password;",
        "Description": "MySQL 示例（注意：MySQL 的 DDL 会隐式提交，演练模式将跳过执行）"
      },
      "MyPostgreSqlDb": {
        "Type": "postgresql",
        "ConnectionString": "Host=localhost;Port=5432;Database=your_pg_db;Username=postgres;Password=your_pg_password;",
        "Description": "PostgreSQL 示例"
      },
      "MySqliteDb": {
        "Type": "sqlite",
        "ConnectionString": "Data Source=/path/to/your.db;",
        "Description": "SQLite 示例（Data Source 为 .db 文件路径；Windows 写 D:\\path\\to\\your.db，macOS/Linux 写 /path/to/your.db）"
      }
    }
  }
}
