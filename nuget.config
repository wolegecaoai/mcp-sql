<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 项目级 NuGet 配置：仅使用 nuget.org 官方源。
       本机全局配置中存在不可达源（https://packagesource、http://192.168.0.101:9528、nuget.cdn.azure.cn），
       会导致整体还原失败；此处清空并锁定官方源，保证本项目可重复构建。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
